# /opt/checkmk-cache-mcp/etc/collector-<site>.env
# EnvironmentFile for the checkmk-cache-collector@<site> systemd service.
# Created automatically by install.sh.

# CheckMK site name (used only for log output)
OMD_SITE=mysite

# Directory where CheckMK writes agent-output files (one file per host)
SOURCE_DIR=/opt/omd/sites/mysite/tmp/check_mk/cache

# Directory where the versioned archive is written
DEST_DIR=/cachehistory/mysite

# How many days of hourly tar.zst archives to keep
RETENTION_DAYS=7

# Log file
LOGFILE=/var/log/checkmk-cache-collector/mysite.log

# zstd compression level (1=fastest, 3=balanced, 9=best)
ZSTD_LEVEL=1

# Parallel cp workers inside each batch flush
BATCH_WORKERS=4

# Files handed to each worker per xargs call
BATCH_SIZE=50

# Seconds between batch-flush cycles
BATCH_FLUSH_INTERVAL=5

# Directory for per-hour flock files (must be writable by the service user)
LOCKDIR=/run/checkmk-cache-collector/mysite
