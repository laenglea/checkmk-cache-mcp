# /etc/sysconfig/checkmk-cache-mcp
# EnvironmentFile for the checkmk-cache-mcp systemd service.
# Copy to /etc/sysconfig/checkmk-cache-mcp and adjust.

# Directory with current agent-output files (one file per host, named by hostname).
# Must match SOURCE_DIR of the collector (or point to the same data).
CHECKMK_CACHE_DIR=/omd/sites/mysite/tmp/check_mk/cache

# Directory with hourly archives written by the collector.
# Leave empty to disable historical tools (get_history_*).
CHECKMK_HISTORY_DIR=/cachehistory/mysite

# Timezone used in archive filenames (Europe/Vaduz, UTC, Europe/Berlin, ...)
CHECKMK_FILE_TZ=Europe/Vaduz

# MCP server listen address and port
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Optional API key for Bearer / X-Api-Key authentication.
# Leave empty to disable authentication (only do this on a trusted network).
MCP_API_KEY=
